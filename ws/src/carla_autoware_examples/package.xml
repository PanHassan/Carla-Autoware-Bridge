<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_autoware_examples</name>
  <version>0.1.0</version>
  <description>Przykładowe węzły ROS 2 do pracy z Autoware i CARLA - punkt startowy dla projektów studenckich</description>
  <maintainer email="pmichalski@autonomous-systems.pl">Pawel Michalski</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
