# Wersje komponentów - zmieniaj tylko tutaj.
# ROS_DISTRO: jazzy (Ubuntu 24.04, zalecane) albo humble (Ubuntu 22.04, EOL 05.2027)
ROS_DISTRO=jazzy
# AUTOWARE_VERSION wybiera tag obrazu w GHCR. Obraz bazowy Autoware jest przypięty
# w docker/autoware/Dockerfile: przy zmianie wersji zaktualizuj też go tam.
AUTOWARE_VERSION=1.9.0
CARLA_VERSION=0.9.16

# Argumenty serwera CARLA. -RenderOffScreen = bez okna symulatora (podgląd jest w RViz);
# na RTX 3060 Laptop daje to ~3x szybszą symulację niż z oknem.
# Usuń -RenderOffScreen, jeśli chcesz widzieć okno CARLA.
CARLA_ARGS="-RenderOffScreen -quality-level=Low -nosound"

# Katalog z danymi Autoware na hoście (mapy i modele ML).
AUTOWARE_DATA=${HOME}/autoware_data
