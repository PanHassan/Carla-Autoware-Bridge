# Wersje komponentów - zmieniaj tylko tutaj.
# ROS_DISTRO: jazzy (Ubuntu 24.04, zalecane) albo humble (Ubuntu 22.04, EOL 05.2027)
ROS_DISTRO=jazzy
# AUTOWARE_VERSION wybiera tag obrazu w GHCR. Obraz bazowy Autoware jest przypięty
# w docker/autoware/Dockerfile: przy zmianie wersji zaktualizuj też go tam.
AUTOWARE_VERSION=1.9.0
CARLA_VERSION=0.9.16

# Argumenty serwera CARLA. -RenderOffScreen = bez okna symulatora (podgląd jest w RViz).
# Okno włącza ./scripts/carla_server.sh --window (sam usuwa tę flagę), bez zmian w tym pliku.
CARLA_ARGS="-RenderOffScreen -nosound"

# Jakość grafiki CARLA: Epic (ładniej) albo Low (szybciej). Dotyczy wszystkiego, co renderuje
# serwer: okna, carla-manual i kamer Autoware. Po zmianie: ./scripts/carla_server.sh
CARLA_QUALITY=Epic

# Rozmiar okna CARLA przy ./scripts/carla_server.sh --window. Większe okno w jakości Epic
# mocno obciąża GPU serwera (2300x1370: ~11-32 ms na krok, 1280x720: ~3-8 ms).
CARLA_WINDOW_RES=1280x720

# Mapa CARLA (ładuje ją carla-master). Wszystkie Autoware podłączone do tej CARLA jeżdżą
# na tej mapie. Po zmianie: docker compose up -d
CARLA_MAP=Town01

# Ruch uliczny na serwerze CARLA: liczba aut na autopilocie (0 = bez ruchu). Po zmianie:
# ./scripts/carla_server.sh (albo docker compose up -d carla-master)
CARLA_NPC_VEHICLES=0

# Kamera okna CARLA (tylko z ./scripts/carla_server.sh --window): top = na starcie z góry na całą
# mapę, potem swobodna (mysz + WASD), follow = za kolejnymi autami, off = bez ustawiania.
CARLA_SPECTATOR=top

# Adres serwera CARLA, z którym łączy się Autoware. localhost = CARLA na tym komputerze.
# Wspólny serwer w laboratorium: wpisz jego adres IP.
CARLA_HOST=192.168.0.106
CARLA_PORT=2000

# Katalog z danymi Autoware na hoście (mapy i modele ML).
AUTOWARE_DATA=${HOME}/autoware_data
